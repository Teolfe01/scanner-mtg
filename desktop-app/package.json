{
  "name": "biblioteca-mtg",
  "productName": "Biblioteca MTG",
  "version": "1.0.4",
  "description": "Biblioteca MTG para Windows",
  "main": "main.js",
  "author": "Scanner MTG",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.teolfe01.bibliotecamtg.desktop",
    "productName": "Biblioteca MTG",
    "artifactName": "BibliotecaMTG.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  }
}