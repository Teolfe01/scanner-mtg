{
  "appId": "io.github.teolfe01.bibliotecamtg.app",
  "appName": "Biblioteca MTG",
  "webDir": "www",
  "server": {
    "url": "https://teolfe01.github.io/scanner-mtg/?source=native",
    "allowNavigation": [
      "teolfe01.github.io"
    ],
    "androidScheme": "https"
  },
  "android": {
