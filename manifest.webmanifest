{
  "id": "./",
  "name": "Biblioteca MTG",
  "short_name": "Biblioteca MTG",
  "description": "Escaneie, catalogue e monte decks de Magic: The Gathering.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#121316",
  "theme_color": "#121316",
  "lang": "pt-BR",
  "categories": ["games", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Escanear cartas", "short_name": "Escanear", "url": "./?tab=scan", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Decks", "url": "./?tab=decks", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Coleção", "url": "./?tab=col", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
